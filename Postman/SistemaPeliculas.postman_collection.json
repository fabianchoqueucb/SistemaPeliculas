        {
          "name": "CU-01 Login moderador (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status 200\", () => pm.response.to.have.status(200));",
                  "const t = pm.response.json().token; if (pm.environment.name) { pm.environment.set(\"token_moderador\", t); } else { pm.collectionVariables.set(\"token_moderador\", t); }"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/auth/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"ana.moderadora@peliculas.com\",\n  \"password\": \"Moderador.2026\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
